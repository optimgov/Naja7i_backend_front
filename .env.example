APP_NAME=Naja7i
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# La plateforme parle français et arabe : `en` n'a AUCUN fichier de traduction.
# Le laisser par défaut fait sortir la clé brute (« errors.csrf_mismatch ») dès
# qu'une erreur survient avant le middleware SetLocale — typiquement un jeton
# CSRF périmé, qui est justement l'erreur que le candidat rencontre le plus.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Argon2id et non bcrypt : bcrypt tronque silencieusement à 72 OCTETS, ce qui
# ampute une phrase de passe en arabe (2 octets par caractère) bien avant
# qu'elle ne paraisse longue. Deux phrases distinctes peuvent alors ouvrir le
# même compte. BCRYPT_ROUNDS reste utile aux condensés hérités.
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=naja7i
DB_USERNAME=naja7i
DB_PASSWORD=naja7i_dev

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# Authentification par cookies de session, jamais par jeton bearer (ADR-0004).
# Le navigateur ne parle qu'au BFF ; SANCTUM_STATEFUL_DOMAINS énumère les
# origines qui ont droit au cookie de session.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Vérification de l'e-mail : 'registration' (bloquant dès l'inscription),
# 'after_diagnostic' ou 'never'. Voir config/naja7i.php et ADR-0004.
EMAIL_VERIFICATION_GATE=registration

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Le fournisseur d'e-mail est une variable d'environnement, jamais un choix de
# code (ADR-0008 §1) : en changer est un redéploiement. Ici, Mailpit — SMTP sur
# le port 1025, consultation sur http://localhost:8025.
# Le domaine d'expédition reste le nôtre, jamais celui du prestataire : la
# réputation d'expéditeur se construit sur des années et doit survivre à un
# changement de fournisseur (ADR-0008 §2).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@naja7i.ma"
MAIL_FROM_NAME="Naja7i.ma"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
