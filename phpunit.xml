<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            La suite complète dépasse désormais la valeur CLI par défaut de
            128 Mio pendant la construction du cache de métadonnées PHPUnit.
            Cette enveloppe concerne uniquement le processus de test ; elle ne
            modifie aucune limite applicative ni aucun conteneur de production.
        -->
        <ini name="memory_limit" value="256M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!--
            Le hasher testé doit être celui de la production : argon2id. Le
            laisser dépendre du .env local ferait passer les tests sous bcrypt
            chez l'un, sous argon2id en intégration continue chez l'autre —
            or c'est précisément la troncature à 72 octets de bcrypt que
            test_un_mot_de_passe_unicode_est_accepte cherche à écarter.
        -->
        <env name="HASH_DRIVER" value="argon2id"/>
        <!--
            MÊME ALGORITHME, FACTEUR DE TRAVAIL RÉDUIT.

            Argon2id est lent PAR CONCEPTION : mesuré à 99,9 ms par hachage aux
            réglages de production, contre 0,7 ms ici — et chaque test crée deux
            à trois comptes. C'était le premier poste de la suite, loin devant
            les semis.

            Baisser le coût ne dénature pas ce que le commentaire ci-dessus
            protège : la troncature à 72 octets est une propriété de l'ALGORITHME
            bcrypt, pas de son facteur de travail. `test_un_mot_de_passe_unicode_
            est_accepte` continue donc de vérifier exactement ce pour quoi il a
            été écrit, sous argon2id, en 0,7 ms.

            NE JAMAIS reprendre ces valeurs en production : elles rendraient une
            empreinte cassable hors ligne. Elles vivent ici, et nulle part ailleurs.
        -->
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_TIME" value="2"/>
        <env name="ARGON_THREADS" value="1"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Les tests tournent sur PostgreSQL, jamais sur SQLite (ADR-0002) :
            les migrations utilisent citext, des types ENUM et des index
            partiels que SQLite ne sait pas exécuter. Base dédiée naja7i_test.
            Création : docker compose exec postgres createdb -U naja7i naja7i_test
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="naja7i_test"/>
        <env name="DB_USERNAME" value="naja7i"/>
        <env name="DB_PASSWORD" value="naja7i_dev"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
